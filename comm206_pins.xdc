# COMM206_fpga_pin_map.pdf. Board clock and I/O standards come from board_config.tcl.
# Page 2: MAIN_CLOCK1. Page 4: SW_0, SW_1, SW_2, SW_3 and SW_*.
set_property PACKAGE_PIN B6 [get_ports clk_sys]
set_property PACKAGE_PIN L1 [get_ports sw_0]
set_property PACKAGE_PIN K4 [get_ports sw_1]
set_property PACKAGE_PIN N8 [get_ports sw_2]
set_property PACKAGE_PIN N4 [get_ports sw_3]
set_property PACKAGE_PIN L7 [get_ports sw_star]

# Page 3: LED1 to LED8.
set_property PACKAGE_PIN L4 [get_ports {led[0]}]
set_property PACKAGE_PIN M4 [get_ports {led[1]}]
set_property PACKAGE_PIN M2 [get_ports {led[2]}]
set_property PACKAGE_PIN N7 [get_ports {led[3]}]
set_property PACKAGE_PIN M7 [get_ports {led[4]}]
set_property PACKAGE_PIN M3 [get_ports {led[5]}]
set_property PACKAGE_PIN M1 [get_ports {led[6]}]
set_property PACKAGE_PIN N5 [get_ports {led[7]}]

# Page 8: AR_SEG_A through AR_SEG_DP, and AR_SEG_S0 through AR_SEG_S7.
set_property PACKAGE_PIN F1 [get_ports {seg_data[0]}]
set_property PACKAGE_PIN F5 [get_ports {seg_data[1]}]
set_property PACKAGE_PIN E2 [get_ports {seg_data[2]}]
set_property PACKAGE_PIN E4 [get_ports {seg_data[3]}]
set_property PACKAGE_PIN J1 [get_ports {seg_data[4]}]
set_property PACKAGE_PIN J3 [get_ports {seg_data[5]}]
set_property PACKAGE_PIN J7 [get_ports {seg_data[6]}]
set_property PACKAGE_PIN H2 [get_ports {seg_data[7]}]
set_property PACKAGE_PIN H4 [get_ports {seg_com[0]}]
set_property PACKAGE_PIN H6 [get_ports {seg_com[1]}]
set_property PACKAGE_PIN G1 [get_ports {seg_com[2]}]
set_property PACKAGE_PIN G3 [get_ports {seg_com[3]}]
set_property PACKAGE_PIN L6 [get_ports {seg_com[4]}]
set_property PACKAGE_PIN K1 [get_ports {seg_com[5]}]
set_property PACKAGE_PIN K3 [get_ports {seg_com[6]}]
set_property PACKAGE_PIN K5 [get_ports {seg_com[7]}]

# Page 16: first base E_GREEN, second N_GREEN, third W_GREEN.
set_property PACKAGE_PIN A20 [get_ports {base_lights[0]}]
set_property PACKAGE_PIN E11 [get_ports {base_lights[1]}]
set_property PACKAGE_PIN C16 [get_ports {base_lights[2]}]

# Page 10: PIEZO. Page 11: CLED_R/G/B numbered 1 to 4.
set_property PACKAGE_PIN Y21 [get_ports piezo]
set_property PACKAGE_PIN T2 [get_ports {rgb_r[0]}]
set_property PACKAGE_PIN U1 [get_ports {rgb_r[1]}]
set_property PACKAGE_PIN P2 [get_ports {rgb_r[2]}]
set_property PACKAGE_PIN R3 [get_ports {rgb_r[3]}]
set_property PACKAGE_PIN U5 [get_ports {rgb_g[0]}]
set_property PACKAGE_PIN V1 [get_ports {rgb_g[1]}]
set_property PACKAGE_PIN R7 [get_ports {rgb_g[2]}]
set_property PACKAGE_PIN T6 [get_ports {rgb_g[3]}]
set_property PACKAGE_PIN U3 [get_ports {rgb_b[0]}]
set_property PACKAGE_PIN W2 [get_ports {rgb_b[1]}]
set_property PACKAGE_PIN R5 [get_ports {rgb_b[2]}]
set_property PACKAGE_PIN T3 [get_ports {rgb_b[3]}]

# Page 13: LCD_D0 through LCD_D7, LCD_RS, LCD_RW and LCD_E.
set_property PACKAGE_PIN A4 [get_ports {lcd_data[0]}]
set_property PACKAGE_PIN B2 [get_ports {lcd_data[1]}]
set_property PACKAGE_PIN C3 [get_ports {lcd_data[2]}]
set_property PACKAGE_PIN D4 [get_ports {lcd_data[3]}]
set_property PACKAGE_PIN A2 [get_ports {lcd_data[4]}]
set_property PACKAGE_PIN C5 [get_ports {lcd_data[5]}]
set_property PACKAGE_PIN C1 [get_ports {lcd_data[6]}]
set_property PACKAGE_PIN D1 [get_ports {lcd_data[7]}]
set_property PACKAGE_PIN G6 [get_ports lcd_rs]
set_property PACKAGE_PIN D6 [get_ports lcd_rw]
set_property PACKAGE_PIN A6 [get_ports lcd_e]
